server {
    listen       8080;
    server_name  localhost;

    include /etc/nginx/security-headers.conf;

    # Root directory where React.js build files are placed
    root /usr/share/nginx/html;
    index index.html;

    # Serve React.js static files with proper caching
    location / {
        try_files $uri /index.html;
    }

    # index.html must never be cached so the browser always picks up
    # newly hashed JS/CSS chunks after a deploy (avoids stale-chunk errors)
    location = /index.html {
        # A location with add_header does not inherit server-level add_header.
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        expires -1;
    }

    location = / {
        try_files /index.html =404;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        expires -1;
    }

    # Runtime config must never be cached (changes on every deploy)
    location = /runtime-config.js {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
        expires -1;
    }

    # Never serve the SPA document for obsolete script URLs.
    location ~* \.js$ {
        add_header Cache-Control "no-store" always;
        return 404;
    }

    # Only content-hashed build assets are immutable.
    location ^~ /assets/ {
        expires 1y;
        access_log off;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Handle React.js client-side routing
    location /static/ {
        expires 1y;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, immutable";
    }

    # Proxy API requests to the Java backend
    location /api/ {
        limit_req zone=api_limit burst=30 nodelay;
        proxy_pass ${API_UPSTREAM}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }
}
