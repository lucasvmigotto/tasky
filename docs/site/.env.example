# Branding and absolute URLs for the docs site.
VITE_APP_SITE_NAME=tasky
# Absolute site origin used in canonical/OG/Twitter URLs (no trailing slash).
# Points at the docs-hub prefix (one bucket, ADR 0001 in lucas/docs).
VITE_SITE_URL=https://docs.lucasvmigotto.me/tasky
# The Open Graph image is always public/og-image.png (generate with `bun run og`).
