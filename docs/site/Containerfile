# syntax=docker/dockerfile:1
# Documentation site — multi-stage: Bun build → pinned nginx runtime.
# Build with the docs/site directory as context:
#   podman build -f docs/site/Containerfile docs/site
ARG BUN_VERSION=1
ARG NGINX_VERSION=stable-alpine

FROM docker.io/oven/bun:${BUN_VERSION}@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895 AS build
WORKDIR /app

ARG DOCS_APP_VERSION=""

# Dependencies resolve from the manifest + lockfile with a cache mount.
RUN --mount=type=bind,source=package.json,target=package.json \
    --mount=type=bind,source=bun.lock,target=bun.lock \
    --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --frozen-lockfile

# Copy the sources in and build. A copy (not a bind mount) is required: Vite
# writes temp files beside its config, which a read-only mount forbids.
RUN --mount=type=bind,target=/src-ro \
    cp -a /src-ro/. . \
    && DOCS_APP_VERSION="${DOCS_APP_VERSION}" bun run build

FROM docker.io/library/nginx:${NGINX_VERSION}@sha256:ef8676b33d681f272ba429b27658bdd7e640963279714c96bddf1dc76307f7b6 AS runtime

# Apply Alpine security patches on top of the pinned digest (expat, pcre2).
# A digest refresh within stable-alpine does not always carry them.
RUN apk upgrade --no-cache

ARG VERSION=0.0.0
LABEL org.opencontainers.image.title="tasky-docs" \
      org.opencontainers.image.description="TaskY documentation site" \
      org.opencontainers.image.licenses="UNLICENSED" \
      org.opencontainers.image.version="${VERSION}"

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=nginx:nginx /app/dist/ /usr/share/nginx/html/

# Run unprivileged: the stock image's pid/cache paths are root-owned and its
# entrypoint rewrites configuration in place. Move the pid, drop the `user`
# directive, and give nginx a writable cache it owns.
RUN sed -i \
      -e 's#^pid .*#pid /tmp/nginx.pid;#' \
      -e 's#^user .*##' \
      /etc/nginx/nginx.conf \
    && sed -i 's#^http {#http {\n    client_body_temp_path /tmp/client_temp;\n    proxy_temp_path /tmp/proxy_temp;\n    fastcgi_temp_path /tmp/fastcgi_temp;\n    uwsgi_temp_path /tmp/uwsgi_temp;\n    scgi_temp_path /tmp/scgi_temp;#' /etc/nginx/nginx.conf

ENV NGINX_ENTRYPOINT_QUIET_LOGS=1
EXPOSE 8080
USER nginx
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/ >/dev/null 2>&1 || exit 1
