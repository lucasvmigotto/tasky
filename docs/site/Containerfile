# syntax=docker/dockerfile:1
# Documentation site — multi-stage: Bun build → pinned nginx runtime.
# Build with the docs/site directory as context:
#   podman build -f docs/site/Containerfile docs/site
ARG BUN_VERSION=1
ARG NGINX_VERSION=stable-alpine

FROM oven/bun:${BUN_VERSION}@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895 AS build
WORKDIR /src

ARG DOCS_APP_VERSION=""

# Dependencies resolve from the manifest + lockfile with a cache mount.
RUN --mount=type=bind,source=package.json,target=package.json \
    --mount=type=bind,source=bun.lock,target=bun.lock \
    --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --frozen-lockfile

# Build the site from the sources; the version may arrive as a build arg.
RUN --mount=type=bind,target=. \
    --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    DOCS_APP_VERSION="${DOCS_APP_VERSION}" bun run build

FROM nginx:${NGINX_VERSION}@sha256:ef8676b33d681f272ba429b27658bdd7e640963279714c96bddf1dc76307f7b6 AS runtime

ARG VERSION=0.0.0
LABEL org.opencontainers.image.title="tasky-docs" \
      org.opencontainers.image.description="TaskY documentation site" \
      org.opencontainers.image.licenses="UNLICENSED" \
      org.opencontainers.image.version="${VERSION}"

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=nginx:nginx /src/dist/ /usr/share/nginx/html/

EXPOSE 8080
USER nginx
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/ >/dev/null 2>&1 || exit 1
