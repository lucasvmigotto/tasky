# Database
POSTGRES_DB=tasky
POSTGRES_USER=tasky
POSTGRES_PASSWORD=change_me_in_production

# Local Compose host bindings (development only; production uses another approach).
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=5173
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MOCK_OAUTH2_BIND_ADDRESS=127.0.0.1
MOCK_OAUTH2_PORT=48080

# JWT - obrigatorio, Base64 de pelo menos 32 bytes. Gere com:
#   openssl rand -base64 32
JWT_SECRET=generate-a-256-bit-base64-secret-key-here-change-in-production
JWT_EXPIRATION_HOURS=24

# Google OAuth (real provider; leave empty for mock-only local development)
GOOGLE_CLIENT_ID=
DEMO_MODE=false
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID (real provider; leave empty for mock-only local development)
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common

# Local mock OIDC (mock-oauth2-server). Enabled by default in development.
MOCK_OAUTH2_ENABLED=true
MOCK_OAUTH2_URL=http://localhost:48080
MOCK_OAUTH2_GOOGLE_ISSUER=http://mock-oauth2:8080/tasky-google-mock
MOCK_OAUTH2_MICROSOFT_ISSUER=http://mock-oauth2:8080/tasky-microsoft-mock

# Redis cache (development)
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO S3-compatible storage (development)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_ENDPOINT=http://localhost:9000
TASKY_STORAGE_BUCKET=tasky-dev

# Application
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Super admin (plataforma): e-mails que recebem o papel super_admin ao logar.
# Separados por vírgula. Gerencia configurações globais em Administrador > Configurações.
TASKY_SUPER_ADMINS=

# Azure Blob Storage: connection string usada no seed inicial de storage.azureConnectionString.
# Depois de definida pelo super admin no banco (mascarada), esta variável é ignorada.
AZURE_STORAGE_CONNECTION_STRING=

# Uploads de arquivo quando o Azure não está configurado (fallback local).
TASKY_UPLOAD_DIR=./data/uploads
